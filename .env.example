# Copy to .env for local development. Never commit .env.
DATABASE_URL="file:./dev.db"
AUTH_SECRET=
AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Stripe test credentials while developing. Add live credentials only after launch review.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set the one-time membership amount and currency before enabling checkout.
MEMBERSHIP_PRICE_CENTS=
MEMBERSHIP_CURRENCY=AUD

# Explicit launch gate. Checkout remains disabled until set to true.
ENABLE_CHECKOUT=false

# Optional: set both values, then run npm run db:seed to create or update an admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Site Owner"

# Absolute path to a persistent private directory outside public/.
# Defaults to ./storage/resources for local development.
RESOURCE_STORAGE_DIR=

# Optional newsletter email provider (Resend). Leave blank to store sign-ups only.
# With both set, a confirmation email is attempted and reported only if the API accepts it.
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=

# First-party aggregate analytics (event name + day counts only). On by default; set to false to disable.
ANALYTICS_ENABLED=true
